<apex:page standardController="Credit_Memo__c" 
           recordSetVar="records" 
           extensions="CreditMemoExtension" 
           showHeader="true" 
           sidebar="false">

    <div id="lightningMode" style="display:none; text-align: center; margin-top: 50px; font-family: 'Salesforce Sans', sans-serif;">
        <h3 style="color: #16325c; font-size: 18px;">{!$Label.Loading_Title}</h3>
    </div>

    <div id="classicMode" style="display:none;">
        <apex:sectionHeader title="{!$Label.Credit_Memo_Edit_Title}" subtitle="{!$Label.Credit_Memo_New_Title}"/>
        <apex:pageMessages />
        <apex:form >
            <apex:pageBlock title="{!$Label.Credit_Memo_Edit_Title}" mode="edit">
                <apex:pageBlockButtons >
                    <apex:commandButton value="{!$Label.Save_Title}" action="{!save}"/>
                    <apex:commandButton value="{!$Label.Cancel_Title}" action="{!cancel}"/>
                </apex:pageBlockButtons>
                
                <apex:pageBlockSection title="{!$Label.Information_Title}" columns="2">
                    <apex:inputField value="{!memo.Name}"/>
                    <apex:inputField value="{!memo.CurrencyIsoCode}"/>
                    <apex:inputField value="{!memo.Valid_From__c}" required="true"/>
                    <apex:inputField value="{!memo.Account__c}" required="true"/>
                    <apex:inputField value="{!memo.Amount__c}" required="true"/>
                    <apex:inputField value="{!memo.Credit_Expiry_Date__c}" required="true"/>
                    <apex:inputField value="{!memo.Exclusively_For__c}"/>
                    <apex:pageBlockSectionItem /> 
                </apex:pageBlockSection>

                <apex:pageBlockSection title="{!$Label.Notes_Title}" columns="1">
                    <apex:inputField value="{!memo.Notes__c}"/>
                </apex:pageBlockSection>
            </apex:pageBlock>
        </apex:form>
    </div>
    <script type="text/javascript">
            document.addEventListener('DOMContentLoaded', function() {
                var isLightning = (typeof sforce !== 'undefined' && sforce && sforce.one);

                if (isLightning) {
                    document.getElementById('lightningMode').style.display = 'block';
                    
                    var notesText = "{!JSENCODE(notesForLightning)}";
                    var defaultValues = "Notes__c=" + encodeURIComponent(notesText);
                    
                    var returnUrl = "/lightning/o/Credit_Memo__c/list?filterName=__Recent";
                    var encodedReturnUrl = encodeURIComponent(returnUrl);
                    
                    var fullUrl = "/lightning/o/Credit_Memo__c/new?defaultFieldValues=" + defaultValues + "&backgroundContext=" + encodedReturnUrl;
                    
                    window.top.location.replace(fullUrl);
                    
                } else {
                    document.getElementById('classicMode').style.display = 'block';
                }
            });
        </script>
</apex:page>
