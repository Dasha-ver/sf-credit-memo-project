<apex:page standardController="Credit_Memo__c" 
           extensions="CreditMemoExtension" 
           showHeader="true" 
           sidebar="true">

    <apex:sectionHeader title="{!$Label.Credit_Memo_Edit_Title}" subtitle="{!$Label.Credit_Memo_New_Title}"/>
    <apex:pageMessages />
    
    <apex:form >
        <apex:pageBlock title="{!$Label.Credit_Memo_Edit_Title}" mode="edit">
            <apex:pageBlockButtons >
                <apex:commandButton value="{!$Label.Save_Title}" action="{!save}"/>
                <apex:commandButton value="{!$Label.Cancel_Title}" action="{!cancel}"/>
            </apex:pageBlockButtons>
            
            <apex:pageBlockSection title="{!$Label.Information_Title}" columns="2">
                <apex:inputField value="{!memo.Name}"/>
                <apex:inputField value="{!memo.CurrencyIsoCode}"/>
                <apex:inputField value="{!memo.Valid_From__c}" required="true"/>
                <apex:inputField value="{!memo.Account__c}" required="true"/>
                <apex:inputField value="{!memo.Amount__c}" required="true"/>
                <apex:inputField value="{!memo.Credit_Expiry_Date__c}" required="true"/>
                <apex:inputField value="{!memo.Exclusively_For__c}"/>
                <apex:pageBlockSectionItem /> 
            </apex:pageBlockSection>

            <apex:pageBlockSection title="{!$Label.Notes_Title}" columns="1">
                <apex:inputField value="{!memo.Notes__c}"/>
            </apex:pageBlockSection>
        </apex:pageBlock>
    </apex:form>
</apex:page>